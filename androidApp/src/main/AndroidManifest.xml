<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <uses-permission android:name="android.permission.ACCESS_ASSISTED_GPS" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />


    <application android:name="ink.chyk.pass.NEUPassApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/neu_app_name"
        android:networkSecurityConfig="@xml/network_security_rules"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.UniversalPass"
        tools:targetApi="31">
        <activity
            android:name="ink.chyk.pass.activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UniversalPass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="ink.chyk.pass.activities.LoginActivity" />
        <activity android:name="ink.chyk.pass.activities.TermsOfServiceActivity" />
        <activity android:name="ink.chyk.pass.activities.CampusRunningActivity" />
        <activity android:name="ink.chyk.pass.activities.JwappActivity" />
        <activity android:name="ink.chyk.pass.activities.FakeECodeActivity" />
        <activity android:name="ink.chyk.pass.activities.WebPageActivity" />

        <service
            android:name="com.tencent.smtt.export.external.DexClassLoaderProviderService"
            android:label="dexopt"
            android:process=":dexopt" />

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
